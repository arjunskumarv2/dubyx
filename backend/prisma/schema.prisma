generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALESMAN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum StockMovementType {
  IN
  OUT
  DAMAGED
  EXPIRED
  ADJUSTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
}

enum VanLoadStatus {
  ACTIVE
  RETURNED
  CLOSED
}

enum StockRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VatCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
}

enum InvoiceType {
  STANDARD
  SIMPLIFIED
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum ZatcaStatus {
  NOT_SUBMITTED
  REPORTED
  CLEARED
  FAILED
}

enum JourneyType {
  PLANNED
  EMERGENCY
}

enum JourneyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JourneyStopStatus {
  PENDING
  VISITED
  SKIPPED
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  password    String
  role        Role     @default(SALESMAN)
  isActive    Boolean  @default(true)
  avatar      String?
  area        String?
  fcmToken    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders           Order[]
  gpsLogs          GpsLog[]
  collections      Collection[]
  invoices         Invoice[]
  routes           Route[]
  checkIns         CheckIn[]
  vanLoads         VanLoad[]
  attendance       Attendance[]
  stockRequests    StockRequest[]
  assignedVehicles Vehicle[]
  journeyPlans     JourneyPlan[]
  journeys         Journey[]      @relation("JourneySalesman")
  createdJourneys  Journey[]      @relation("JourneyCreator")

  @@map("users")
}

model Customer {
  id             String   @id @default(uuid())
  shopName       String
  arabicShopName String?
  ownerName      String
  phone          String
  email          String?
  address        String
  area           String
  route          String?
  latitude       Float?
  longitude      Float?
  creditLimit    Float    @default(0)
  taxNumber      String?
  vatNumber      String?
  crNumber       String?
  buildingNumber String?
  street         String?
  district       String?
  city           String?
  postalCode     String?
  additionalNumber String?
  photos         String[]
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders       Order[]
  collections  Collection[]
  invoices     Invoice[]
  routeStops   RouteStop[]
  checkIns     CheckIn[]
  journeyStops JourneyStop[]

  @@map("customers")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("categories")
}

model Product {
  id             String    @id @default(uuid())
  name           String
  sku            String    @unique
  barcode        String?
  description    String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  sellingPrice   Float
  costPrice      Float
  taxRate        Float       @default(15)
  vatCategory    VatCategory @default(STANDARD)
  unit           String    @default("PCS")
  currentStock   Int       @default(0)
  minStock       Int       @default(10)
  expiryDate     DateTime?
  image          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  vanLoadItems      VanLoadItem[]
  stockRequestItems StockRequestItem[]

  @@map("products")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  salesmanId   String
  salesman     User        @relation(fields: [salesmanId], references: [id])
  status       OrderStatus @default(PENDING)
  subtotal     Float
  taxAmount    Float       @default(0)
  discount     Float       @default(0)
  total        Float
  notes        String?
  deliveryDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]
  invoice      Invoice?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  discount  Float   @default(0)
  taxRate   Float   @default(0)
  total     Float

  @@map("order_items")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  uuid           String        @unique @default(uuid())
  invoiceType    InvoiceType   @default(STANDARD)
  invoiceKind    InvoiceKind   @default(INVOICE)
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  generatedById  String
  generatedBy    User          @relation(fields: [generatedById], references: [id])
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Float
  taxAmount      Float         @default(0)
  discount       Float         @default(0)
  total          Float
  paidAmount     Float         @default(0)
  dueDate        DateTime?
  supplyDate     DateTime?
  notes          String?
  pdfPath        String?
  xmlPath        String?

  // ZATCA e-invoicing (Fatoora)
  qrCode         String?       @db.Text
  invoiceHash    String?
  previousHash   String?
  zatcaStatus    ZatcaStatus   @default(NOT_SUBMITTED)
  zatcaMessage   String?

  // Credit / debit notes reference the invoice they correct
  originalInvoiceId String?
  originalInvoice   Invoice?   @relation("InvoiceCorrections", fields: [originalInvoiceId], references: [id])
  corrections       Invoice[]  @relation("InvoiceCorrections")
  noteReason        String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  collections    Collection[]

  @@map("invoices")
}

model Collection {
  id           String        @id @default(uuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  collectedById String
  collectedBy  User          @relation(fields: [collectedById], references: [id])
  amount       Float
  method       PaymentMethod @default(CASH)
  reference    String?
  notes        String?
  collectedAt  DateTime      @default(now())

  @@map("collections")
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Int
  reason      String?
  reference   String?
  createdAt   DateTime          @default(now())

  @@map("stock_movements")
}

model GpsLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  latitude  Float
  longitude Float
  accuracy  Float?
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())

  @@map("gps_logs")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Route {
  id         String      @id @default(uuid())
  name       String
  salesmanId String
  salesman   User        @relation(fields: [salesmanId], references: [id])
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  stops      RouteStop[]
  planDays   JourneyPlanDay[]
  journeys   Journey[]

  @@map("routes")
}

model RouteStop {
  id         String   @id @default(uuid())
  routeId    String
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  stopOrder  Int

  @@map("route_stops")
}

model Vehicle {
  id             String    @id @default(uuid())
  vehicleNumber  String    @unique
  make           String?
  model          String?
  color          String?
  notes          String?
  isActive       Boolean   @default(true)
  assignedToId   String?
  assignedTo     User?     @relation(fields: [assignedToId], references: [id])
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vanLoads       VanLoad[]
  journeyPlans   JourneyPlan[]
  journeys       Journey[]

  @@map("vehicles")
}

model VanLoad {
  id          String        @id @default(uuid())
  loadNumber  String        @unique
  vehicleId   String?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])
  salesmanId  String
  salesman    User          @relation(fields: [salesmanId], references: [id])
  status      VanLoadStatus @default(ACTIVE)
  notes       String?
  loadedAt    DateTime      @default(now())
  returnedAt  DateTime?
  items       VanLoadItem[]

  @@map("van_loads")
}

model VanLoadItem {
  id          String   @id @default(uuid())
  vanLoadId   String
  vanLoad     VanLoad  @relation(fields: [vanLoadId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  loadedQty   Int
  soldQty     Int      @default(0)
  returnedQty Int      @default(0)

  @@unique([vanLoadId, productId])
  @@map("van_load_items")
}

model CheckIn {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  latitude    Float
  longitude   Float
  selfiePath  String?
  notes       String?
  checkedInAt DateTime @default(now())

  @@map("check_ins")
}

model Attendance {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  date              DateTime
  checkInAt         DateTime  @default(now())
  checkInLatitude   Float
  checkInLongitude  Float
  checkInPhoto      String?
  checkOutAt        DateTime?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutPhoto     String?
  totalMinutes      Int?

  @@map("attendance")
}

model StockRequest {
  id              String             @id @default(uuid())
  requestNumber   String             @unique
  requestedById   String
  requestedBy     User               @relation(fields: [requestedById], references: [id])
  status          StockRequestStatus @default(PENDING)
  notes           String?
  vanLoadId       String?
  items           StockRequestItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("stock_requests")
}

model StockRequestItem {
  id             String       @id @default(uuid())
  stockRequestId String
  stockRequest   StockRequest @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  requestedQty   Int

  @@map("stock_request_items")
}

model JourneyPlan {
  id         String    @id @default(uuid())
  name       String
  salesmanId String
  salesman   User      @relation(fields: [salesmanId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  days     JourneyPlanDay[]
  journeys Journey[]

  @@map("journey_plans")
}

model JourneyPlanDay {
  id        String      @id @default(uuid())
  planId    String
  plan      JourneyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  routeId   String
  route     Route       @relation(fields: [routeId], references: [id])
  startTime String?
  notes     String?

  @@unique([planId, dayOfWeek])
  @@map("journey_plan_days")
}

model Journey {
  id            String        @id @default(uuid())
  journeyNumber String        @unique
  type          JourneyType   @default(PLANNED)
  status        JourneyStatus @default(PENDING)
  date          DateTime
  salesmanId    String
  salesman      User          @relation("JourneySalesman", fields: [salesmanId], references: [id])
  planId        String?
  plan          JourneyPlan?  @relation(fields: [planId], references: [id])
  routeId       String?
  route         Route?        @relation(fields: [routeId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  reason        String?
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdById   String?
  createdBy     User?         @relation("JourneyCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stops JourneyStop[]

  @@index([salesmanId, date])
  @@map("journeys")
}

model JourneyStop {
  id         String            @id @default(uuid())
  journeyId  String
  journey    Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  stopOrder  Int
  status     JourneyStopStatus @default(PENDING)
  notes      String?
  visitedAt  DateTime?

  @@unique([journeyId, customerId])
  @@map("journey_stops")
}
